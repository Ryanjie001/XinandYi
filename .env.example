# Actual values belong only in ignored .env.local / server secret files.
DATABASE_ENV=development
APP_URL=http://127.0.0.1:3000
BETTER_AUTH_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
MYSQL_TUNNEL_PORT=13306
DATABASE_URL="mysql://xinanyi_dev_app:REPLACE_LOCALLY@127.0.0.1:13306/xinanyi_dev?connection_limit=3"
MIGRATION_DATABASE_URL="mysql://xinanyi_dev_migrator:REPLACE_LOCALLY@127.0.0.1:13306/xinanyi_dev?connection_limit=2"
SHADOW_DATABASE_URL="mysql://xinanyi_dev_migrator:REPLACE_LOCALLY@127.0.0.1:13306/xinanyi_shadow?connection_limit=2"
COS_BUCKET=your-bucket-appid
COS_REGION=ap-chengdu
COS_PREFIX=xinanyi/development
COS_SECRET_ID=REPLACE_LOCALLY
COS_SECRET_KEY=REPLACE_LOCALLY
